<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_custom_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_amoled" />

    <LinearLayout
        android:id="@+id/widget_favorites_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_fav_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FAVORITE SHORTCUTS"
            android:textColor="#FFE11D48"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_fav_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No favorites pinned yet. Open Nexus System to add shortcuts."
            android:textColor="#FF9CA3AF"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/widget_fav_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_fav_slot_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#FF14161D"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_fav_slot_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#FF14161D"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_fav_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_fav_slot_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="#FF14161D"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_fav_slot_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#FF14161D"
                android:ellipsize="end"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
