<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_custom_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <ImageView
        android:id="@+id/widget_custom_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Custom Studio Widget"
        android:scaleType="fitCenter" />

    <ViewFlipper
        android:id="@+id/widget_custom_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="180"
        android:visibility="gone" />

    <!-- Native launcher-ticked TextClock overlays for Visual Clock & Date widgets -->
    <TextClock
        android:id="@+id/widget_custom_live_clock_bold"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/widget_custom_live_clock_reg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/widget_custom_live_date_bold"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:format12Hour="EEE, MMM dd"
        android:format24Hour="EEE, MMM dd"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextClock
        android:id="@+id/widget_custom_live_date_reg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:format12Hour="EEE, MMM dd"
        android:format24Hour="EEE, MMM dd"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="normal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_custom_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_amoled"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/widget_custom_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NEXUS WIDGET STUDIO"
            android:textColor="#E11D48"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_custom_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Design a visual or HTML widget in Nexus System"
            android:textColor="#D1D5DB"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
